{
  "name": "xorgate-workflow-engine",
  "version": "0.0.1",
  "private": true,
  "description": "Portable xorgate workflow engine: runGraph + the full 26-node catalog, extracted from xorgate-core-service. No AWS dependencies.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "xwe": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test": "npm run build && node scripts/golden-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.19.2",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ffmpeg-static": "^5.2.0",
    "typescript": "~5.9.3"
  }
}
