{
  "schemaVersion": 2,
  "nodes": [
    {
      "id": "src",
      "type": "source.video",
      "data": {
        "label": "Video",
        "config": {}
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "dec",
      "type": "video.decode_sample",
      "data": {
        "label": "Decode & sample",
        "config": {
          "fps": 2
        }
      },
      "position": {
        "x": 200,
        "y": 0
      }
    },
    {
      "id": "det",
      "type": "model.object_detection",
      "data": {
        "label": "Forklift detector",
        "config": {
          "model": "acme-forklift",
          "minConfidence": 0.4
        }
      },
      "position": {
        "x": 400,
        "y": 0
      }
    },
    {
      "id": "fn",
      "type": "function.javascript",
      "data": {
        "label": "Forklift summary",
        "config": {
          "handler": "handler",
          "timeoutMs": 1000,
          "memoryMb": 128,
          "code": "async function handler(event, context) {\n  const forklifts = event.payload.boxes.filter((b) => b.cls === \"forklift\")\n  if (forklifts.length === 0) return null // nothing to record for this frame\n  const widest = forklifts.reduce((a, b) => (width(b) > width(a) ? b : a))\n  return {\n    frameSeq: event.payload.frameSeq,\n    count: forklifts.length,\n    widestPx: Math.round(width(widest)),\n    confidence: widest.confidence,\n  }\n}\n\nfunction width(box) {\n  const [x1, , x2] = box.xyxy\n  return x2 - x1\n}\n",
          "versions": [],
          "deployedVersion": null
        }
      },
      "position": {
        "x": 600,
        "y": 0
      }
    },
    {
      "id": "cap",
      "type": "output.data_capture",
      "data": {
        "label": "Forklift summaries",
        "config": {
          "format": "jsonl"
        }
      },
      "position": {
        "x": 800,
        "y": 0
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "src",
      "target": "dec"
